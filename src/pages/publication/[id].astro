---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Article from '../../layouts/Article.astro';
import Icon from '../../components/Icon.astro';
import { profile } from '../../data/profile';
import { url, formatDate } from '../../utils';

export async function getStaticPaths() {
  const pubs = await getCollection('publications');
  return pubs.map((pub) => ({ params: { id: pub.id }, props: { pub } }));
}

const { pub } = Astro.props;
const { title, authors, venue, date, type, award, pdf, doi, image, imageAlt, tags, summary } = pub.data;
const { Content } = await render(pub);
const isSelf = (name: string) => (profile.authorNames as readonly string[]).includes(name);
const ogImage = image ? (await getImage({ src: image, width: 720, format: 'jpeg' })).src : undefined;
---

<Article title={title} description={summary} ogImage={ogImage} back={{ label: 'All publications', href: 'publication/' }}>
  <Fragment slot="header">
    <p class="eyebrow">{type}</p>
    <h1 class="title">{title}</h1>
    <p class="authors">
      {authors.map((a, i) => <>{isSelf(a) ? <strong>{a}</strong> : a}{i < authors.length - 1 && ', '}</>)}
    </p>
    <p class="muted"><em>{venue}</em> · {formatDate(date)}</p>
    {award && <p class="award"><span class="badge"><Icon name="award" size={15} /> {award}</span></p>}
    <div class="actions">
      {pdf && <a href={url(`publication/${pub.id}/${encodeURIComponent(pdf)}`)}><Icon name="pdf" size={16} /> PDF</a>}
      {doi && <a href={`https://doi.org/${doi}`}><Icon name="external" size={16} /> DOI</a>}
    </div>
  </Fragment>

  <h2>Abstract</h2>
  <div class="prose"><Content /></div>
  {tags.length > 0 && <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>}
  {image && <Image src={image} alt={imageAlt} class="figure" width={720} />}
</Article>

<style>
  .title { font-size: clamp(1.6rem, 4vw, 2.2rem); }
  .authors { margin: 0 0 0.25rem; }
  header p { margin: 0; }
  .award { margin-top: 0.75rem; }
  .actions { display: flex; gap: 0.6rem; margin-top: 1rem; }
  .actions a {
    display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.9rem; border-radius: 999px;
    border: 1px solid var(--border); color: var(--text); text-decoration: none; font-weight: 500; font-size: 0.92rem;
  }
  .actions a:hover { border-color: var(--accent); color: var(--accent); }
  h2 { font-size: 1.15rem; }
  .tags { margin-top: 1.5rem; }
  :global(.figure) { margin-top: 2rem; border-radius: 12px; border: 1px solid var(--border); background: #fff; }
</style>
