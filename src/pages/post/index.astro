---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, formatDate } from '../../utils';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Posts" description="All blog posts.">
  <section class="container narrow wrap">
    <h1>Posts</h1>
    <ul>
      {posts.map((p) => (
        <li>
          <time class="muted" datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
          <h2><a href={url(`post/${p.id}/`)}>{p.data.title}</a></h2>
          {p.data.summary && <p class="muted">{p.data.summary}</p>}
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .wrap { padding-block: 3rem; }
  ul { list-style: none; padding: 0; margin: 2rem 0 0; }
  li { padding-block: 1.25rem; border-bottom: 1px solid var(--border); }
  time { font-size: 0.9rem; }
  h2 { font-size: 1.3rem; margin: 0.2rem 0 0.3rem; }
  h2 a { color: var(--text); text-decoration: none; }
  h2 a:hover { color: var(--accent); }
  p { margin: 0; }
</style>
