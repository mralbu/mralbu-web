---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { url, formatDate, readingTime, slugify } from '../../utils';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Article title={post.data.title} description={post.data.summary} back={{ label: 'All posts', href: 'post/' }}>
  <Fragment slot="header">
    <h1>{post.data.title}</h1>
    <p class="muted">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.updated && (
        <> · Updated <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time></>
      )}
      · {readingTime(post.body)} min read
    </p>
    {post.data.tags.length > 0 && (
      <ul class="tags post-tags">
        {post.data.tags.map((t) => <li><a href={url(`tag/${slugify(t)}/`)}>{t}</a></li>)}
      </ul>
    )}
  </Fragment>
  <div class="prose"><Content /></div>
</Article>

<style>
  p { margin: 0; }
  .post-tags { margin-top: 0.9rem; }
</style>
