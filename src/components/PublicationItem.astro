---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { url, formatDate } from '../utils';

interface Props { pub: CollectionEntry<'publications'> }
const { pub } = Astro.props;
const { title, authors, venue, date, image, pdf, award } = pub.data;
const isSelf = (name: string) => (profile.authorNames as readonly string[]).includes(name);
---

<article class="pub">
  {image && (
    <a class="thumb" href={url(`publication/${pub.id}/`)} tabindex="-1" aria-hidden="true">
      <Image src={image} alt="" width={160} height={160} />
    </a>
  )}
  <div>
    <h3><a href={url(`publication/${pub.id}/`)}>{title}</a></h3>
    <p class="authors">
      {authors.map((a, i) => (
        <>{isSelf(a) ? <strong>{a}</strong> : a}{i < authors.length - 1 && ', '}</>
      ))}
    </p>
    <p class="meta muted"><em>{venue}</em> · {formatDate(date, 'year')}</p>
    {award && <p class="award"><span class="badge"><Icon name="award" size={14} /> {award}</span></p>}
    <div class="actions">
      {pdf && <a href={url(`publication/${pub.id}/${encodeURIComponent(pdf)}`)}><Icon name="pdf" size={15} /> PDF</a>}
      <a href={url(`publication/${pub.id}/`)}>Details <Icon name="arrow" size={15} /></a>
    </div>
  </div>
</article>

<style>
  .pub { display: grid; grid-template-columns: 6rem 1fr; gap: 1.25rem; align-items: start; }
  .pub:not(:has(.thumb)) { grid-template-columns: 1fr; }
  .thumb img { width: 6rem; height: 6rem; object-fit: cover; border-radius: 10px; border: 1px solid var(--border); background: #fff; }
  h3 { margin: 0 0 0.35rem; font-size: 1.08rem; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  .authors { margin: 0; font-size: 0.95rem; }
  .meta { margin: 0.15rem 0 0.5rem; font-size: 0.92rem; }
  .award { margin: 0 0 0.6rem; }
  .actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .actions a {
    display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.82rem; font-weight: 500;
    padding: 0.25rem 0.7rem; border: 1px solid var(--border); border-radius: 999px; text-decoration: none; color: var(--text);
  }
  .actions a:hover { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 30rem) {
    .pub { grid-template-columns: 4rem 1fr; gap: 0.9rem; }
    .thumb img { width: 4rem; height: 4rem; }
  }
</style>
