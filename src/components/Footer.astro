---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { url } from '../utils';
---

<footer>
  <div class="container row">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <ul>
      {profile.social.map((s) => (
        <li><a href={s.url} aria-label={s.label} title={s.label}><Icon name={s.icon} size={18} /></a></li>
      ))}
      <li><a href={url('rss.xml')} aria-label="RSS feed" title="RSS feed"><Icon name="rss" size={18} /></a></li>
    </ul>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--border); padding-block: 2rem; margin-top: 2rem; color: var(--muted); font-size: 0.9rem; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  p { margin: 0; }
  ul { display: flex; gap: 0.75rem; list-style: none; margin: 0; padding: 0; }
  a { color: var(--muted); display: inline-flex; }
  a:hover { color: var(--accent); }
</style>
